# Runway API key — get from https://dev.runwayml.com
RUNWAYML_API_SECRET=your_runway_api_key_here

# LLM for story parsing (OpenAI or compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.5

# Runway model config
IMAGE_MODEL=gen4_image
VIDEO_MODEL=gen4_turbo
VIDEO_DURATION=5
VIDEO_RATIO=1280:720

# Generation concurrency (stay within your tier limits)
GEN_CONCURRENCY=3

# Auth
SECRET_KEY=change-me-to-random-32-char-string

# Database (SQLite for dev, PostgreSQL for prod)
# DATABASE_URL=postgresql://user:pass@localhost/inkframe

# Redis (optional — set RUN_TASKS_INLINE=true to skip Redis in dev)
REDIS_URL=redis://localhost:6379/0
RUN_TASKS_INLINE=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credits per user on signup
INITIAL_CREDITS=100

# Public URL for Runway tool callbacks (Feature 8 — Director)
# Must be publicly reachable (use ngrok in dev: ngrok http 8000)
PUBLIC_URL=http://localhost:8000
