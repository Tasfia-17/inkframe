# ── Required ──────────────────────────────────────────────────
RUNWAYML_API_SECRET=your_runway_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SECRET_KEY=generate-a-random-32-char-string-here

# ── Railway: set DATA_DIR to your volume mount path ───────────
# In Railway: add a Volume mounted at /data, then set:
DATA_DIR=/data

# ── CORS: set to your Vercel frontend URL ─────────────────────
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Optional overrides ────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
GEN_CONCURRENCY=5
VIDEO_DURATION=4
RUN_TASKS_INLINE=true
COOKIE_SECURE=true
COOKIE_SAMESITE=none
